TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
AVALAI_BASE_URL=https://api.avalai.ir/v1
AVALAI_MODEL=deepseek-v4-flash
LOG_LEVEL=INFO

# Runtime paths; generated data and secrets stay outside Git.
# Quote paths that contain spaces so this file is safe for both systemd EnvironmentFile and shell sourcing.
DRJAVAN_ARCHIVE_DIR="گروه دکتر جوان"
DRJAVAN_DATA_DIR=runtime/data
DRJAVAN_CACHE_DIR=runtime/cache
DRJAVAN_LOG_DIR=runtime/logs

# Optional AI tuning. AVALAI_API_KEY is intentionally NOT stored here.
# Stage 2 selects thinking/reasoning per stage: FAST paths disable thinking; strong synthesis/verification can enable it.
DRJAVAN_AI_TIMEOUT_SECONDS=25
DRJAVAN_AI_MAX_RETRIES=2
DRJAVAN_AI_RETRY_BASE_SECONDS=0.4
DRJAVAN_AI_CACHE_TTL_SECONDS=86400
# Small structured calls used before retrieval. Search hints are never evidence.
DRJAVAN_AI_PLANNER_MAX_OUTPUT_TOKENS=320
DRJAVAN_AI_REFINEMENT_MAX_OUTPUT_TOKENS=220
# Legacy compatibility only; semantic retrieval no longer uses flat expansion in production.
DRJAVAN_AI_EXPANSION_MAX_OUTPUT_TOKENS=180
DRJAVAN_AI_SIMPLE_EVIDENCE_TOKENS=2500
DRJAVAN_AI_MEDIUM_EVIDENCE_TOKENS=5000
DRJAVAN_AI_COMPLEX_EVIDENCE_TOKENS=8000
DRJAVAN_AI_HARD_EVIDENCE_TOKENS=9000
# Generation ceilings prevent JSON truncation; billing is based on tokens actually generated, not these caps.
DRJAVAN_AI_SIMPLE_OUTPUT_TOKENS=800
DRJAVAN_AI_MEDIUM_OUTPUT_TOKENS=1200
DRJAVAN_AI_COMPLEX_OUTPUT_TOKENS=1800
DRJAVAN_AI_STRUCTURED_RETRY_OUTPUT_TOKENS=2400

# Telegram runtime tuning; no secrets here.
DRJAVAN_TG_POLL_TIMEOUT_SECONDS=25
DRJAVAN_TG_WORKERS=4
DRJAVAN_TG_MAX_QUESTION_CHARS=2000
DRJAVAN_TG_RATE_LIMIT_PER_MINUTE=6
DRJAVAN_TG_KEY_ENTRY_TIMEOUT_SECONDS=300
DRJAVAN_TG_SOURCE_SESSION_TTL_SECONDS=3600
# Rich Message presentation is enabled by default. Set false for presentation-only rollback; answer/retrieval logic is unchanged.
DRJAVAN_TG_RICH_UI_ENABLED=true
# Show one transient, editable status message while planner/search/context/synthesis run.
# It exposes only operational milestones/counts, never hidden chain-of-thought or unvalidated archive text.
DRJAVAN_TG_PROGRESS_UI_ENABLED=true
# Check public GitHub main on startup and every 5 minutes; notify Owner only when a newer SHA exists.
DRJAVAN_TG_UPDATE_CHECK_INTERVAL_SECONDS=300

# Intelligence v2 rollout flags. Production Stage 2 enables all three; set false for immediate architecture rollback.
DRJAVAN_INTELLIGENCE_V2=false
DRJAVAN_SOURCE_ROUTER_V2=false
DRJAVAN_HYBRID_RETRIEVAL_V2=false
# Optional stage-specific model policy. Simple deterministic QI normally uses 0 AI calls.
# DRJAVAN_AI_FAST_MODEL=deepseek-v4-flash
# DRJAVAN_AI_REASONING_MODEL=deepseek-v4-pro
# DRJAVAN_AI_QI_FAST_OUTPUT_TOKENS=480
# DRJAVAN_AI_QI_REASONING_OUTPUT_TOKENS=900
# DRJAVAN_AI_SYNTHESIS_OUTPUT_TOKENS=1600
# DRJAVAN_AI_VERIFICATION_OUTPUT_TOKENS=900
# DRJAVAN_AI_FAST_REASONING_EFFORT=low
# DRJAVAN_AI_STRONG_REASONING_EFFORT=high

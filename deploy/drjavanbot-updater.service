[Unit]
Description=DrJavanBot secure atomic updater
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/drjavanbot/current
ExecStart=/usr/bin/python3 /opt/drjavanbot/current/deploy/self_update.py
SuccessExitStatus=1
ExecStartPost=-/bin/chown drjavanbot:drjavanbot /var/lib/drjavanbot/update/result.json
ExecStartPost=-/bin/chmod 0600 /var/lib/drjavanbot/update/result.json
ExecStartPost=-/bin/chown drjavanbot:drjavanbot /var/lib/drjavanbot/update/history.json
ExecStartPost=-/bin/chmod 0600 /var/lib/drjavanbot/update/history.json
TimeoutStartSec=1800
UMask=0077
RuntimeDirectory=drjavanbot-updater
RuntimeDirectoryMode=0700
Environment=TMPDIR=/run/drjavanbot-updater
Environment=TEMP=/run/drjavanbot-updater
Environment=TMP=/run/drjavanbot-updater
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=full
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
